{
  "manifest_version": 3,
  "name": "Claude Quota Guardian — Monitor",
  "version": "1.1.7",
  "description": "Tu consumo de Claude en vivo (5h, semanal, por modelo) y cuánto le queda al caché de Claude Code. Sin tokens ni credenciales.",
  "key": "",
  "permissions": [
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Guardian — consumo de Claude",
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
